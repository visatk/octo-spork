{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parak",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "visatk",
      "database_id": "45daddfe-0e9e-44e3-aa9b-367ffe349f30"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WALLET_DO",
        "class_name": "WalletDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WalletDO"]
    }
  ]
}
